{
  "name": "pekral/phpstan-rules",
  "description": "Extensible package of custom rules for PHPStan.",
  "type": "phpstan-extension",
  "keywords": [
    "phpstan",
    "rules",
    "static analysis",
    "coding standard",
    "quality",
    "php"
  ],
  "homepage": "https://github.com/pekral/phpstan-rules",
  "license": ["MIT"],
  "authors": [
    {
      "name": "Petr Král",
      "email": "kral.petr.88@gmail.com",
      "homepage": "https://github.com/pekral",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/pekral/phpstan-rules/issues",
    "source": "https://github.com/pekral/phpstan-rules"
  },
  "require": {
    "php": "^8.4",
    "phpstan/phpstan": "^2.2.6",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan-strict-rules": "^2.0.12"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "pekral/phpcs-rules": "dev-master",
    "pekral/cursor-rules": "dev-master",
    "pekral/rector-rules": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "Pekral\\PhpstanRules\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pekral/cursor-rules": true
    }
  },
  "scripts": {
    "build": "composer fix && composer check && composer dump-autoload && composer cursor-rules:install",
    "phpcs": "phpcs --standard=vendor/pekral/phpcs-rules/ruleset.xml examples/ build/",
    "phpcs-fix": "phpcbf --standard=vendor/pekral/phpcs-rules/ruleset.xml examples/ build/ || true",
    "phpstan": "phpstan analyse examples/ build/  --memory-limit=-1",
    "check-strict-rules": "php build/check-strict-rules.php",
    "check": "composer phpcs && composer phpstan && composer check-strict-rules",
    "fix": "composer phpcs-fix",
    "cursor-rules:install": "vendor/bin/cursor-rules install --force --editor=claude"
  }
}
